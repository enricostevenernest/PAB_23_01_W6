<resources>
    <style name="Theme.PAB_23_01_W5" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="BottomNavigationItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/nav_item_tint</item>
        <item name="android:textColor">@color/nav_item_tint</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/nav_item_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
